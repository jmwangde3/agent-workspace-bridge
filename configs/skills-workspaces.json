{
  "note": "示例分配表。global = 所有工作空间可见；rules 第一条命中生效，未命中的工作空间只有 global。改分类只改本文件，再跑 python scope_skills.py --apply。示例中的工作空间名请换成你自己的。",
  "workspace_root": "<在 config.json 的 workspace_root 指定>",
  "vault": "<在 config.json 的 skills_vault 指定>",
  "global": [
    "handoff-kb",
    "logged-in-web-read",
    "sync-agent-memory",
    "win-script-writer"
  ],
  "bundles": {
    "ops": ["windows-gui-tools", "openwrt-router-ops"],
    "network": ["openwrt-router-ops"],
    "game": ["game-pipeline", "game-modding", "video-watch", "video-index"],
    "game_lite": ["game-pipeline"],
    "hiring": ["resume-audit", "resume-flaw-scan", "resume-jd-evidence"],
    "jobsearch": ["job-scraper"]
  },
  "rules": [
    { "match": "example-cheats", "bundles": ["game_lite"] },
    { "match": "^(example-game|example-game-.*)$", "bundles": ["game"] },
    { "match": "^example-ops$", "bundles": ["ops"] },
    { "match": "^example-network$", "bundles": ["network"] },
    { "match": "(example-hiring|hiring|resume)", "bundles": ["hiring", "jobsearch"] }
  ],
  "project_skill_dirs": [".codebuddy/skills", ".workbuddy/skills"]
}
